 <application android:label="XH光流" android:allowBackup="false" android:debuggable="false" android:usesCleartextTraffic="true" android:theme="@android:style/Theme.Material.NoActionBar" android:icon="@mipmap/ic_xh_flow" android:roundIcon="@mipmap/ic_xh_flow" android:banner="@drawable/xh_flow_banner">
